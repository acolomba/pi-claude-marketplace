{
  "entry": ["extensions/pi-claude-marketplace/index.ts"],
  "rulePacks": ["rule-packs/architecture.json"],
  "ignorePatterns": [".pi/**", ".planning/**"],
  "production": {
    "deadCode": true,
    "health": false,
    "dupes": false
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxUnitSize": 60,
    "maxCrap": 0
  },
  "boundaries": {
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["eslint.config.js", "scripts/**", "tests/**", "demos/**"]
    },
    "zones": [
      {
        "name": "entry",
        "patterns": ["extensions/pi-claude-marketplace/index.ts"]
      },
      {
        "name": "edge",
        "patterns": ["extensions/pi-claude-marketplace/edge/**"]
      },
      {
        "name": "orchestrators",
        "patterns": ["extensions/pi-claude-marketplace/orchestrators/**"]
      },
      {
        "name": "bridges-agents",
        "patterns": ["extensions/pi-claude-marketplace/bridges/agents/**"]
      },
      {
        "name": "bridges-commands",
        "patterns": ["extensions/pi-claude-marketplace/bridges/commands/**"]
      },
      {
        "name": "bridges-mcp",
        "patterns": ["extensions/pi-claude-marketplace/bridges/mcp/**"]
      },
      {
        "name": "bridges-skills",
        "patterns": ["extensions/pi-claude-marketplace/bridges/skills/**"]
      },
      {
        "name": "bridges-hooks",
        "patterns": ["extensions/pi-claude-marketplace/bridges/hooks/**"]
      },
      {
        "name": "bridges-workflows",
        "patterns": ["extensions/pi-claude-marketplace/bridges/workflows/**"]
      },
      {
        "name": "domain",
        "patterns": ["extensions/pi-claude-marketplace/domain/**"]
      },
      {
        "name": "transaction",
        "patterns": ["extensions/pi-claude-marketplace/transaction/**"]
      },
      {
        "name": "persistence",
        "patterns": ["extensions/pi-claude-marketplace/persistence/**"]
      },
      {
        "name": "platform",
        "patterns": ["extensions/pi-claude-marketplace/platform/**"]
      },
      {
        "name": "shared",
        "patterns": ["extensions/pi-claude-marketplace/shared/**"]
      }
    ],
    "rules": [
      {
        "from": "entry",
        "allow": ["edge", "orchestrators", "bridges-hooks", "persistence", "platform", "shared"]
      },
      {
        "from": "edge",
        "allow": ["orchestrators", "domain", "shared", "platform"]
      },
      {
        "from": "orchestrators",
        "allow": [
          "bridges-agents",
          "bridges-commands",
          "bridges-mcp",
          "bridges-skills",
          "bridges-hooks",
          "bridges-workflows",
          "domain",
          "transaction",
          "persistence",
          "platform",
          "shared"
        ]
      },
      {
        "from": "bridges-agents",
        "allow": ["domain", "persistence", "shared", "platform"]
      },
      {
        "from": "bridges-commands",
        "allow": ["domain", "persistence", "shared", "platform"]
      },
      {
        "from": "bridges-mcp",
        "allow": ["domain", "persistence", "shared", "platform"]
      },
      {
        "from": "bridges-skills",
        "allow": ["domain", "persistence", "shared", "platform"]
      },
      {
        "from": "bridges-hooks",
        "allow": ["domain", "persistence", "shared", "platform"]
      },
      {
        "from": "bridges-workflows",
        "allow": ["domain", "persistence", "shared", "platform"]
      },
      {
        "from": "domain",
        "allow": ["shared", "platform"]
      },
      {
        "from": "transaction",
        "allow": ["persistence", "shared", "platform"]
      },
      {
        "from": "persistence",
        "allow": ["domain", "shared", "platform"]
      },
      {
        "from": "platform",
        "allow": ["shared"]
      },
      {
        "from": "shared",
        "allow": ["platform"]
      }
    ]
  },
  "duplicates": {
    "ignoredClones": ["dup:cc950b18:2", "dup:6d8c002d:2"],
    "threshold": 3
  },
  "includeEntryExports": true,
  "rules": {
    "private-type-leaks": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "policy-violation": "error"
  }
}

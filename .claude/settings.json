{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ \"$(git rev-parse --path-format=absolute --git-dir)\" != \"$(git rev-parse --path-format=absolute --git-common-dir)\" ] && [ ! -e node_modules/.init-done ] && { mkdir -p node_modules && scripts/init.sh >node_modules/.init.log 2>&1 || echo \"scripts/init.sh failed; see node_modules/.init.log\" >&2; } || true",
            "timeout": 900
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/init-worktree.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__codegraph__codegraph_explore",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/codegraph-worktree-hook.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/stop-worktree-daemon.sh"
          }
        ]
      }
    ]
  }
}

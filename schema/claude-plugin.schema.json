            "label": { "type": "string" },
            "failures": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "success": {
              "type": "object",
              "required": ["count"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "verb": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false

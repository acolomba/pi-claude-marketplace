{
  "default": {
    "import": ["features/support/**/*.ts", "features/step_definitions/**/*.steps.ts"],
    "format": ["summary"],
    "order": "random",
    "tags": "not @builtin-only",
    "worldParameters": { "mcpImplementation": "adapter" }
  },
  "adapter": {
    "import": ["features/support/**/*.ts", "features/step_definitions/**/*.steps.ts"],
    "format": ["summary"],
    "order": "random",
    "tags": "not @builtin-only",
    "worldParameters": { "mcpImplementation": "adapter" }
  },
  "builtin": {
    "import": ["features/support/**/*.ts", "features/step_definitions/**/*.steps.ts"],
    "format": ["summary"],
    "order": "random",
    "tags": "(@mcp or @builtin-only) and not @adapter-only",
    "worldParameters": { "mcpImplementation": "builtin" }
  }
}

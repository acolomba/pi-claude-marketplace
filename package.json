{
  "author": {
    "name": "Alessandro Colomba"
  },
  "bugs": {
    "url": "https://github.com/acolomba/pi-claude-marketplace/issues"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "isomorphic-git": "^1.41.8",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.8.5",
    "strip-json-comments": "^5.0.3",
    "write-file-atomic": "^8.0.0"
  },
  "description": "Access Claude plugin marketplaces from Pi Coding Agent. Supports Claude commands, skills, agents, hooks, MCP servers, and workflows.",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.8.0",
    "@types/write-file-atomic": "^4.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fallow": "^3.31.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "strong-mock": "^9.2.2",
    "typebox": "^1.3.34",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "extensions/pi-claude-marketplace/**"
  ],
  "homepage": "https://github.com/acolomba/pi-claude-marketplace#readme",
  "keywords": [
    "claude",
    "claude-code",
    "marketplace",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "plugins"
  ],
  "license": "MIT",
  "name": "pi-claude-marketplace",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": "*",
    "pi-mcp-adapter": ">=5.0.0",
    "pi-subagents": ">=0.74.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "pi-mcp-adapter": {
      "optional": true
    },
    "pi-subagents": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/pi-claude-marketplace/index.ts"
    ],
    "image": "https://media.githubusercontent.com/media/acolomba/pi-claude-marketplace/refs/heads/main/demos/bootstrap.gif"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acolomba/pi-claude-marketplace.git"
  },
  "scripts": {
    "check": "npm run --silent check:static && npm run --silent test:unpaired && npm run --silent test:integration && npm run --silent test:coverage:direct:all",
    "check:commit": "npm run --silent check:static && npm run --silent test:unpaired && npm run --silent test:coverage:direct:commit",
    "check:static": "node scripts/run-parallel.mjs typecheck lint lint:workflows fallow format:check test:corresponding",
    "fallow": "q=--quiet; if [ -n \"$CI\" ]; then q=; fi; if fallow rule-pack test --quiet 2>&1 | grep 'WARN.*rule pack'; then exit 1; fi; fallow dead-code --fail-on-issues --format human $q && fallow dead-code --no-production --circular-deps --re-export-cycles --fail-on-issues --format human $q --no-cache && fallow health --fail-on-issues --format human $q --complexity && if [ -n \"$CI\" ]; then fallow dupes --fail-on-issues --format human; else fallow dupes --fail-on-issues --format human --quiet > /dev/null || fallow dupes --fail-on-issues --format human --quiet; fi",
    "format": "prettier --write \"{extensions,rule-packs,tests}/**/*.{js,json,ts}\" \"scripts/**/*.mjs\" \"demos/**/*.ts\" .fallowrc.json .prettierrc.json eslint.config.js package-lock.json package.json tsconfig.json --cache --cache-strategy content",
    "format:check": "prettier --check --log-level warn ${CI:+--log-level log} \"{extensions,rule-packs,tests}/**/*.{js,json,ts}\" \"scripts/**/*.mjs\" \"demos/**/*.ts\" .fallowrc.json .prettierrc.json eslint.config.js package-lock.json package.json tsconfig.json --cache --cache-strategy content",
    "lint": "eslint extensions tests scripts eslint.config.js --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint extensions tests scripts eslint.config.js --fix",
    "lint:workflows": "node scripts/check-workflow-install-scripts.mjs",
    "test": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/{architecture,bridges,domain,edge,orchestrators,persistence,platform,shared,transaction}/**/*.test.ts\" \"tests/index.test.ts\"",
    "test:architecture": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/architecture/**/*.test.ts\"",
    "test:corresponding": "node scripts/check-corresponding-tests.mjs",
    "test:coverage": "rm -rf coverage && mkdir -p coverage && npm run --silent test:coverage:direct:all && npm run --silent test:coverage:integration && npm run --silent test:coverage:e2e",
    "test:coverage:direct": "node scripts/test-coverage-direct.mjs",
    "test:coverage:direct:all": "mkdir -p coverage && node scripts/test-coverage-direct.mjs --all --lcov coverage/direct.lcov",
    "test:coverage:direct:commit": "node scripts/test-coverage-direct.mjs --staged",
    "test:coverage:e2e": "PI_CM_E2E_REF=pinned node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-reporter=./scripts/test-reporter.mjs --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/e2e.lcov \"tests/e2e/**/*.test.ts\"",
    "test:coverage:integration": "node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-reporter=./scripts/test-reporter.mjs --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/integration.lcov \"tests/integration/**/*.test.ts\"",
    "test:e2e": "PI_CM_E2E_REF=pinned node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/e2e/**/*.test.ts\"",
    "test:e2e:nightly": "PI_CM_E2E_REF=main node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/e2e/**/*.test.ts\"",
    "test:integration": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/integration/**/*.test.ts\"",
    "test:modules": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/{bridges,domain,edge,orchestrators,persistence,platform,shared,transaction}/**/*.test.ts\" \"tests/index.test.ts\"",
    "test:unpaired": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/architecture/**/*.test.ts\" \"tests/{domain,platform}/**/*-fake.test.ts\"",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typescript/tsconfig.tsbuildinfo"
  },
  "type": "module",
  "version": "0.19.2"
}

{
  "author": {
    "name": "Alessandro Colomba"
  },
  "bugs": {
    "url": "https://github.com/acolomba/pi-claude-marketplace/issues"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "isomorphic-git": "^1.41.8",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.8.5",
    "write-file-atomic": "^8.0.0"
  },
  "description": "Access Claude plugin marketplaces from Pi Coding Agent. Supports Claude commands, skills, agents, hooks, MCP servers, and workflows.",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.8.0",
    "@types/write-file-atomic": "^4.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fallow": "^3.27.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "strong-mock": "^9.2.2",
    "typebox": "^1.3.34",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "extensions/pi-claude-marketplace/**"
  ],
  "homepage": "https://github.com/acolomba/pi-claude-marketplace#readme",
  "keywords": [
    "claude",
    "claude-code",
    "marketplace",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "plugins"
  ],
  "license": "MIT",
  "name": "pi-claude-marketplace",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-tui": "*",
    "pi-subagents": ">=0.35.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "pi-subagents": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/pi-claude-marketplace/index.ts"
    ],
    "image": "https://media.githubusercontent.com/media/acolomba/pi-claude-marketplace/refs/heads/main/demos/bootstrap.gif"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acolomba/pi-claude-marketplace.git"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run lint:workflows && npm run fallow && npm run format:check && npm run test:corresponding && npm run test:coverage:unit && npm run test:integration && npm run lint:type-members",
    "check:changed": "node scripts/check-changed.mjs",
    "check:changed:negative": "node scripts/check-changed.negative.mjs",
    "check:controls": "npm run lint:workflows:negative && npm run test:corresponding:negative && npm run check:changed:negative && npm run test:reporter:negative && npm run test:coverage:direct:negative && npm run lint:type-members:negative",
    "fallow": "fallow dead-code --fail-on-issues --format human --quiet && fallow dead-code --no-production --circular-deps --re-export-cycles --fail-on-issues --format human --quiet --no-cache && fallow health --fail-on-issues --format human --quiet --complexity && (fallow dupes --fail-on-issues --format human --quiet > /dev/null || fallow dupes --fail-on-issues --format human --quiet)",
    "format": "prettier --write \"**/*.{js,json,ts}\" \"scripts/**/*.mjs\" --cache --cache-strategy content",
    "format:check": "prettier --check \"**/*.{js,json,ts}\" \"scripts/**/*.mjs\" --cache --cache-strategy content",
    "lint": "eslint extensions tests scripts eslint.config.js",
    "lint:fix": "eslint extensions tests scripts eslint.config.js --fix",
    "lint:type-members": "node scripts/check-unused-type-members.mjs",
    "lint:type-members:audit": "node scripts/check-unused-type-members.audit.mjs --check",
    "lint:type-members:negative": "node scripts/check-unused-type-members.negative.mjs",
    "lint:workflows": "node scripts/check-workflow-install-scripts.mjs",
    "lint:workflows:negative": "node scripts/check-workflow-install-scripts.negative.mjs",
    "test": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/{architecture,bridges,domain,edge,orchestrators,persistence,platform,scripts,shared,transaction}/**/*.test.ts\" \"tests/index.test.ts\"",
    "test:analyzers": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/scripts/**/*.test.ts\"",
    "test:architecture": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/architecture/**/*.test.ts\"",
    "test:corresponding": "node scripts/check-corresponding-tests.mjs",
    "test:corresponding:negative": "node scripts/check-corresponding-tests.negative.mjs",
    "test:coverage": "rm -rf coverage && mkdir -p coverage && npm run test:coverage:unit && npm run test:coverage:integration && npm run test:coverage:e2e",
    "test:coverage:direct": "node scripts/test-coverage-direct.mjs",
    "test:coverage:direct:all": "mkdir -p coverage && node scripts/test-coverage-direct.mjs --all --report coverage/all-pairs.jsonl",
    "test:coverage:direct:commit": "node scripts/test-coverage-direct.mjs --base HEAD",
    "test:coverage:direct:negative": "node scripts/test-coverage-direct.negative.mjs",
    "test:coverage:direct:report": "mkdir -p coverage && node scripts/test-coverage-direct.report.mjs coverage/all-pairs-report.ndjson",
    "test:coverage:e2e": "PI_CM_E2E_REF=pinned node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/e2e.lcov \"tests/e2e/**/*.test.ts\"",
    "test:coverage:integration": "node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/integration.lcov \"tests/integration/**/*.test.ts\"",
    "test:coverage:unit": "mkdir -p coverage && node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --experimental-test-coverage --test-coverage-include='extensions/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-reporter=./scripts/test-reporter.mjs --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/unit.lcov \"tests/{architecture,bridges,domain,edge,orchestrators,persistence,platform,scripts,shared,transaction}/**/*.test.ts\" \"tests/index.test.ts\"",
    "test:e2e": "PI_CM_E2E_REF=pinned node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/e2e/**/*.test.ts\"",
    "test:e2e:nightly": "PI_CM_E2E_REF=main node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/e2e/**/*.test.ts\"",
    "test:integration": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/integration/**/*.test.ts\"",
    "test:modules": "node --test --test-reporter=./scripts/test-reporter.mjs ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} \"tests/{bridges,domain,edge,orchestrators,persistence,platform,shared,transaction}/**/*.test.ts\" \"tests/index.test.ts\"",
    "test:reporter:negative": "node scripts/test-reporter.negative.mjs",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typescript/tsconfig.tsbuildinfo"
  },
  "type": "module",
  "version": "0.19.2"
}

{
  "model_profile": "adaptive",
  "model_overrides": {
    "gsd-code-reviewer": "opus"
  },
  "dynamic_routing": {
    "enabled": true,
    "tier_models": { "light": "haiku", "standard": "sonnet", "heavy": "opus" },
    "escalate_on_failure": true,
    "max_escalations": 2
  },
  "effort": {
    "agent_overrides": {
      "gsd-planner": "max"
    }
  },
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "milestone",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "features/{milestone}",
    "quick_branch_template": null,
    "create_tag": false
  },
  "workflow": {
    "context_guard_mode": "auto",
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "_auto_chain_active": false,
    "use_worktrees": true
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {
    "gsd-executor": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-debugger": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-code-fixer": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-nyquist-auditor": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-code-reviewer": [
      "skills/typescript-comments",
      "skills/typescript-google-style-review",
      "skills/typescript-unit-testing-review"
    ],
    "gsd-verifier": ["skills/typescript-unit-testing-review"]
  },
  "features": {},
  "mode": "yolo",
  "granularity": "standard",
  "claude_md_assembly": {
    "mode": "link",
    "blocks": {
      "project": "embed"
    }
  },
  "context_window": 1000000
}

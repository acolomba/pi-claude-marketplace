{
  "model_profile": "quality",
  "model_profile_overrides": {
    "codex": {
      "opus": "gpt-6-sol",
      "sonnet": "gpt-6-terra"
    }
  },
  "git": {
    "create_tag": false,
    "branching_strategy": "none"
  },
  "workflow": {
    "context_guard_mode": "auto",
    "ui_phase": false,
    "ui_safety_gate": false,
    "ui_review": false,
    "test_command": "npm run check",
    "use_worktrees": true,
    "research_before_questions": true,
    "nyquist_validation": true,
    "ai_integration_phase": true,
    "research": true,
    "pattern_mapper": true,
    "tdd_mode": false,
    "code_review": true,
    "code_review_depth": "standard",
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "compact_content": false,
    "skip_discuss": false
  },
  "effort": {
    "agent_overrides": {
      "gsd-planner": "max"
    }
  },
  "code_quality": {
    "fallow": {
      "enabled": true,
      "scope": "repo",
      "mcp": true,
      "profile": "standard"
    }
  },
  "agent_skills": {
    "gsd-discuss-phase": ["skills/claude-code-compat-research"],
    "gsd-advisor-researcher": ["skills/claude-code-compat-research"],
    "gsd-executor": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-debugger": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-code-fixer": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-nyquist-auditor": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-code-reviewer": [
      "skills/typescript-comments",
      "skills/typescript-google-style-review",
      "skills/typescript-unit-testing-review"
    ],
    "gsd-verifier": ["skills/typescript-unit-testing-review"]
  },
  "mode": "yolo",
  "claude_md_assembly": {
    "mode": "link",
    "blocks": {
      "project": "embed"
    }
  },
  "claude_md_path": "AGENTS.md",
  "intel": {
    "enabled": false
  },
  "graphify": {
    "enabled": false
  },
  "commit_docs": true,
  "plan_review": {
    "source_grounding": true
  },
  "hooks": {
    "context_warnings": true
  }
}

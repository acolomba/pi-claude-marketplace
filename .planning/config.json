      "skills/typescript-google-style-review"
    ],
    "gsd-debugger": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-code-fixer": [
      "skills/typescript-comments",
      "skills/typescript-unit-testing",
      "skills/typescript-google-style-review"
    ],
    "gsd-nyquist-auditor": [
      "skills/typescript-comments",

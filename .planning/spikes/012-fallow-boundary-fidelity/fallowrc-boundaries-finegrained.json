{
  "entry": ["extensions/pi-claude-marketplace/index.ts"],
  "production": true,
  "boundaries": {
    "zones": [
      { "name": "edge", "patterns": ["extensions/pi-claude-marketplace/edge/**"] },
      {
        "name": "orchestrators",
        "patterns": ["extensions/pi-claude-marketplace/orchestrators/**"]
      },
      {
        "name": "bridges-agents",
        "patterns": ["extensions/pi-claude-marketplace/bridges/agents/**"]
      },
      {
        "name": "bridges-commands",
        "patterns": ["extensions/pi-claude-marketplace/bridges/commands/**"]
      },
      { "name": "bridges-mcp", "patterns": ["extensions/pi-claude-marketplace/bridges/mcp/**"] },
      {
        "name": "bridges-skills",
        "patterns": ["extensions/pi-claude-marketplace/bridges/skills/**"]
      },
      {
        "name": "bridges-hooks",
        "patterns": ["extensions/pi-claude-marketplace/bridges/hooks/**"]
      },
      { "name": "domain", "patterns": ["extensions/pi-claude-marketplace/domain/**"] },
      {
        "name": "transaction",
        "patterns": ["extensions/pi-claude-marketplace/transaction/**"]
      },
      {
        "name": "persistence",
        "patterns": ["extensions/pi-claude-marketplace/persistence/**"]
      },
      { "name": "platform", "patterns": ["extensions/pi-claude-marketplace/platform/**"] },
      { "name": "shared", "patterns": ["extensions/pi-claude-marketplace/shared/**"] }
    ],
    "rules": [
      {
        "from": "edge",
        "allow": ["orchestrators", "domain", "shared", "platform"]
      },
      {
        "from": "orchestrators",
        "allow": [
          "bridges-agents",
          "bridges-commands",
          "bridges-mcp",
          "bridges-skills",
          "bridges-hooks",
          "domain",
          "transaction",
          "persistence",
          "platform",
          "shared"
        ]
      },
      { "from": "bridges-agents", "allow": ["domain", "persistence", "shared", "platform"] },
      { "from": "bridges-commands", "allow": ["domain", "persistence", "shared", "platform"] },
      { "from": "bridges-mcp", "allow": ["domain", "persistence", "shared", "platform"] },
      { "from": "bridges-skills", "allow": ["domain", "persistence", "shared", "platform"] },
      { "from": "bridges-hooks", "allow": ["domain", "persistence", "shared", "platform"] },
      { "from": "domain", "allow": ["shared", "platform"] },
      { "from": "transaction", "allow": ["persistence", "shared", "platform"] },
      { "from": "persistence", "allow": ["domain", "shared", "platform"] },
      { "from": "platform", "allow": ["shared"] },
      { "from": "shared", "allow": ["platform"] }
    ]
  }
}

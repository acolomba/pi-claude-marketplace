From e191b365809d4255c363335743ec1611f1e107cf Mon Sep 17 00:00:00 2001
From: acolomba <acolomba@gmail.com>
Date: Mon, 2 Nov 2026 02:08:16 +0000
Subject: [PATCH 1/2] fix: resolve mcp: selectors on servers with directTools
 "search"

pi-mcp-adapter 7 accepts `directTools: "search"` on a server and in
`settings`. The config validator accepted only a boolean or a string
array, so it dropped such a server from the loaded config and reported
every `mcp:<server>/<tool>` selector for it as unresolved. A runtime
snapshot of such a server failed validation the same way.

Accept "search" in both places. Selector resolution does not read
`directTools`, and the child's MCP_DIRECT_TOOLS selection overrides it
in the adapter, so "search" needs no other handling here.
---
 src/runs/shared/mcp-config-sources.ts        |  5 +++--
 src/runs/shared/mcp-direct-tool-allowlist.ts |  4 ++--
 test/unit/mcp-direct-tool-resolution.test.ts | 12 ++++++++++++
 3 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/runs/shared/mcp-config-sources.ts b/src/runs/shared/mcp-config-sources.ts
index 2979825..6e3cfca 100644
--- a/src/runs/shared/mcp-config-sources.ts
+++ b/src/runs/shared/mcp-config-sources.ts
@@ -36,7 +36,8 @@ export interface McpServerDefinition {
 	/** Per-server override of the global `settings.toolPrefix`, matching the adapter. */
 	toolPrefix?: McpToolPrefix;
 	protocolVersion?: string;
-	directTools?: boolean | string[];
+	/** pi-mcp-adapter 7 `"search"` registers the tools inactive until searched; `mcp:` selectors do not read this field. */
+	directTools?: boolean | string[] | "search";
 	httpTransport?: string;
 	pluginDataDir?: string;
 	literalEnv?: boolean;
@@ -59,7 +60,7 @@ export function isMcpServerDefinition(value: unknown): value is McpServerDefinit
 	}
 	if (value.requestHeadersCommand !== undefined && !isRequestHeadersCommand(value.requestHeadersCommand)) return false;
 	if (value.auth !== undefined && value.auth !== "oauth" && value.auth !== "bearer" && value.auth !== false) return false;
-	return value.directTools === undefined || typeof value.directTools === "boolean" || isStringArray(value.directTools);
+	return value.directTools === undefined || typeof value.directTools === "boolean" || value.directTools === "search" || isStringArray(value.directTools);
 }

 function isRecord(value: unknown): value is Record<string, unknown> {
diff --git a/src/runs/shared/mcp-direct-tool-allowlist.ts b/src/runs/shared/mcp-direct-tool-allowlist.ts
index 3f0f55d..324f778 100644
--- a/src/runs/shared/mcp-direct-tool-allowlist.ts
+++ b/src/runs/shared/mcp-direct-tool-allowlist.ts
@@ -40,7 +40,7 @@ export interface McpConfig {
 	imports?: ImportKind[];
 	settings?: {
 		toolPrefix?: McpToolPrefix;
-		directTools?: boolean;
+		directTools?: boolean | "search";
 		agentPluginPaths?: unknown;
 	};
 }
@@ -392,7 +392,7 @@ function parseServerEntries(value: unknown): Record<string, ServerEntry> {
 function parseSettings(value: unknown): McpConfig["settings"] | undefined {
 	if (!isRecord(value)) return undefined;
 	const toolPrefix = value.toolPrefix === "server" || value.toolPrefix === "short" || value.toolPrefix === "none" || value.toolPrefix === "mcp" ? value.toolPrefix : undefined;
-	const directTools = typeof value.directTools === "boolean" ? value.directTools : undefined;
+	const directTools = typeof value.directTools === "boolean" || value.directTools === "search" ? value.directTools : undefined;
 	const settings: NonNullable<McpConfig["settings"]> = {
 		...(toolPrefix ? { toolPrefix } : {}),
 		...(directTools !== undefined ? { directTools } : {}),
diff --git a/test/unit/mcp-direct-tool-resolution.test.ts b/test/unit/mcp-direct-tool-resolution.test.ts
index a910299..5467feb 100644
--- a/test/unit/mcp-direct-tool-resolution.test.ts
+++ b/test/unit/mcp-direct-tool-resolution.test.ts
@@ -83,6 +83,18 @@ describe("MCP direct-tool resolution config sources", () => {
 		assert.deepEqual(resolution.unresolvedSelectors, []);
 	});

+	it("resolves direct tools from a server whose directTools is \"search\"", () => {
+		// pi-mcp-adapter 7 accepts "search"; rejecting it dropped the server and left every selector unresolved.
+		const definition: McpServerDefinition = { ...CURRENT_DEFINITION, directTools: "search" };
+		writeServerConfig(path.join(agentDir, "mcp-adapter.json"), definition);
+		writeMetadataCache(definition);
+
+		const resolution = resolveMcpDirectToolResolution(SELECTORS, projectDir);
+
+		assert.deepEqual(resolution.selections.map((selection) => selection.name), SELECTED_NAMES);
+		assert.deepEqual(resolution.unresolvedSelectors, []);
+	});
+
 	it("computes config hashes identical to pi-mcp-adapter 3.1.0 for stdio servers", () => {
 		// Values reproduced from pi-mcp-adapter 3.1.0's real cache; drift breaks stdio direct-tool resolution.
 		assert.equal(computeMcpServerHash(CURRENT_DEFINITION), "d2b80559f0b1c85ccc625a4c7f875f64e0defc60648f56d2a51cbe5dfa3d967e");
--

{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "scripts/mcp-server.sh",
      "args": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "alwaysLoad": true
    },
    "fallow": {
      "type": "stdio",
      "command": "scripts/mcp-server.sh",
      "args": [
        "fallow-mcp"
      ]
    }
  }
}
